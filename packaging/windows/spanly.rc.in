// Version shown in the file's Properties (generated by CMake from the git tag).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @SPANLY_VERSION_MAJOR@,@SPANLY_VERSION_MINOR@,@SPANLY_VERSION_PATCH@,0
PRODUCTVERSION @SPANLY_VERSION_MAJOR@,@SPANLY_VERSION_MINOR@,@SPANLY_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "caigenix"
      VALUE "FileDescription", "Spanly"
      VALUE "FileVersion", "@SPANLY_VERSION@"
      VALUE "InternalName", "spanly"
      VALUE "OriginalFilename", "spanly.exe"
      VALUE "ProductName", "Spanly"
      VALUE "ProductVersion", "@SPANLY_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
